{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YatraVerse Tourism Image Record",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "name",
    "image"
  ],
  "properties": {
    "entity_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "state",
        "city",
        "destination",
        "heritage",
        "monument",
        "museum",
        "attraction",
        "railway_station",
        "hotel"
      ]
    },
    "name": {
      "type": "string"
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "image": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "verified",
            "missing"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source_page": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "creator": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_checked": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
