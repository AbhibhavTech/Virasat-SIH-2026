# Copy selected settings into ignored .env; never commit real keys.
VIRASAT_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
VIRASAT_AI_REQUIRE_HOSTED=true
VIRASAT_AI_TIMEOUT_MS=60000
VIRASAT_AI_MAX_TOKENS=1000
VIRASAT_AI_MAX_CONCURRENCY=4
# Optional same-provider complex-task model; no automatic model substitution:
# VIRASAT_AI_COMPLEX_MODEL=<accessible-reviewed-model-id>
# OpenAI: VIRASAT_AI_PROVIDER=openai, OPENAI_MODEL and OPENAI_API_KEY.
# Local: VIRASAT_AI_PROVIDER=local, VIRASAT_AI_MODEL=<exact-served-model-id>
# VIRASAT_AI_BASE_URL=http://127.0.0.1:11434/v1
# Local loopback inference may omit VIRASAT_AI_API_KEY.
# Remote self-hosting: provider=compatible, HTTPS URL and VIRASAT_AI_API_KEY.
# Optional separate semantic retrieval service (no automatic indexing):
# VIRASAT_EMBEDDING_URL=http://127.0.0.1:11434/v1
# VIRASAT_EMBEDDING_MODEL=<exact-embedding-model-id>
# VIRASAT_EMBEDDING_API_KEY=
