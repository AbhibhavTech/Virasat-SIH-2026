# Copy one provider block into .env (never commit a real key).
VIRASAT_AI_REQUIRE_HOSTED=true

# Groq (default model is a current production model with local tool calling).
VIRASAT_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI alternative:
# VIRASAT_AI_PROVIDER=openai
# OPENAI_MODEL=
# VIRASAT_AI_API_KEY=
# OPENAI_API_KEY may be used instead of VIRASAT_AI_API_KEY.
# OPENAI_BASE_URL=https://api.openai.com/v1

# VIRASAT_AI_MODEL and VIRASAT_AI_BASE_URL override both providers. Leave them
# unset when you want switching to require only VIRASAT_AI_PROVIDER changes.
