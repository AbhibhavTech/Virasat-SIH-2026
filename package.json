{
  "name": "virasat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "benchmark:general": "tsx scripts/benchmark_general.ts",
    "knowledge:ingest": "tsx scripts/knowledge.ts ingest",
    "knowledge:reindex": "tsx scripts/knowledge.ts reindex",
    "knowledge:embed": "tsx scripts/knowledge.ts embed",
    "knowledge:search": "tsx scripts/knowledge.ts search",
    "test:ai-platform": "tsx scripts/test_ai_platform.ts",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/prepare_netlify_redirects.mjs",
    "start": "tsx scripts/migrate_if_configured.ts && node dist/server.cjs",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/check_images_uniqueness.mjs && node scripts/check_duplicate_stations.mjs && tsx scripts/check_data_quality.mjs && tsx scripts/test_phase1_backend.mjs && tsx scripts/test_phase3_ai_itinerary.mjs && tsx scripts/test_phase3b_stewardship.mjs && tsx scripts/test_phase4_auth_google.mjs && tsx scripts/test_phase5_ai_hardening.mjs && node scripts/test_phase6_design_a11y.mjs && tsx scripts/test_phase6_design_system.mjs && tsx scripts/test_phase7_security_and_e2e.mjs && tsx scripts/test_phase8_observability_deploy.mjs && tsx scripts/test_phase9_seo_analytics.mjs && node scripts/test_phase10_sih_packaging.mjs && tsx scripts/test_ai_assistant_multilingual.ts && tsx scripts/verify_chatbot_behavior.ts && npm run test:assistant-upgrades && npm run test:heritage-ai",
    "check:data": "node scripts/check_images_uniqueness.mjs && tsx scripts/check_data_quality.mjs",
    "check:discover-bharat": "node scripts/validate_discover_bharat_regions.mjs",
    "check:images": "node scripts/check_images_uniqueness.mjs",
    "check:stations": "node scripts/check_duplicate_stations.mjs",
    "report:tourism-coverage": "node scripts/report_tourism_coverage.mjs",
    "import:ai-corpus": "node scripts/import_ai_evaluation_corpus.mjs",
    "evaluate:ai": "tsx scripts/evaluate_ai_corpus.ts",
    "test:ai-hosted": "tsx scripts/test_hosted_ai_gateway.ts",
    "test:ai-provider": "tsx scripts/test_ai_configuration.ts && tsx scripts/test_provider_errors.ts && tsx scripts/test_groq_setup.ts && tsx scripts/test_gemini_setup.ts && tsx scripts/test_ai_response_policy.ts && tsx scripts/test_hosted_ai_gateway.ts",
    "setup:ai-groq": "tsx scripts/configure_groq.ts && npm run check:ai-connection",
    "setup:ai-groq:secure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_groq_secure.ps1",
    "setup:ai-gemini": "tsx scripts/configure_gemini.ts",
    "setup:ai-gemini:secure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_gemini_secure.ps1",
    "check:ai-connection": "tsx scripts/check_ai_connection.ts",
    "test:auth": "tsx scripts/test_google_auth.ts",
    "seed:heritages": "tsx scripts/seed_heritages.ts",
    "seed:destinations": "tsx scripts/seed_maharashtra_destinations.ts",
    "test:assistant-upgrades": "tsx scripts/test_assistant_upgrades.ts && tsx scripts/test_assistant_rendering.tsx",
    "test:heritage-ai": "tsx scripts/test_heritage_ai.ts",
    "db:migrate": "tsx scripts/migrate_database.ts",
    "db:verify": "tsx scripts/verify_database.ts",
    "test:database-platform": "node scripts/test_database_platform.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "motion": "^13.4.0",
    "openai": "^7.33.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
